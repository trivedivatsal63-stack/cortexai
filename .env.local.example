# AETHER - AI Learning Companion Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# Clerk Authentication (https://clerk.com)
# Create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Supabase Database (https://supabase.com)
# Create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Groq API (https://groq.com) - for LLM inference
# Get API key at https://console.groq.com
GROQ_API_KEY=gsk_xxx

# =============================================================================
# Optional - Additional Configuration
# =============================================================================

# Anthropic API (optional - for Claude models fallback)
# ANTHROPIC_API_KEY=sk-ant-xxx
